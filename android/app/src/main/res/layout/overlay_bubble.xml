<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Minimized state: just the dot, timer and an expand chevron. -->
    <LinearLayout
        android:id="@+id/bubble_mini"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_overlay_pill"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:elevation="8dp"
        android:visibility="gone">

        <View
            android:id="@+id/bubble_mini_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_rec_dot" />

        <Chronometer
            android:id="@+id/bubble_mini_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:fontFamily="monospace"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/bubble_expand"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@android:color/transparent"
            android:contentDescription="Expandir"
            android:padding="4dp"
            android:src="@drawable/ic_chevron_up" />
    </LinearLayout>

    <!-- Full state: pill + optional Lápis toolbar + optional Mais panel. -->
    <LinearLayout
        android:id="@+id/bubble_full"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/bubble_main_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_overlay_pill"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:elevation="8dp">

            <ImageView
                android:id="@+id/bubble_drag_handle"
                android:layout_width="20dp"
                android:layout_height="28dp"
                android:padding="4dp"
                android:src="@drawable/ic_drag_handle"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:orientation="vertical"
                android:gravity="start">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DRAX"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STUDIO"
                    android:textColor="#9AA1AC"
                    android:textSize="8sp"
                    android:letterSpacing="0.2" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/bubble_rec_dot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_rec_dot" />

                    <Chronometer
                        android:id="@+id/bubble_timer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/bubble_paused_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="Pausado"
                    android:textColor="#FF8A3D"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/bubble_pause"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@android:color/transparent"
                android:contentDescription="Pausar gravação"
                android:padding="6dp"
                android:src="@drawable/ic_pause" />

            <ImageButton
                android:id="@+id/bubble_stop"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_tool_button_active"
                android:contentDescription="Finalizar gravação"
                android:padding="6dp"
                android:src="@drawable/ic_stop"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/bubble_lapis"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="2dp"
                android:background="@android:color/transparent"
                android:contentDescription="Ferramenta de desenho"
                android:padding="6dp"
                android:src="@drawable/ic_pencil" />

            <ImageButton
                android:id="@+id/bubble_mais"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="2dp"
                android:background="@android:color/transparent"
                android:contentDescription="Mais opções"
                android:padding="6dp"
                android:src="@drawable/ic_gear" />

            <ImageButton
                android:id="@+id/bubble_minimize"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="2dp"
                android:background="@android:color/transparent"
                android:contentDescription="Minimizar"
                android:padding="2dp"
                android:src="@drawable/ic_chevron_down" />
        </LinearLayout>

        <!-- Lápis toolbar -->
        <LinearLayout
            android:id="@+id/lapis_toolbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_overlay_pill"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:elevation="8dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/tool_caneta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <ImageButton
                    android:id="@+id/tool_caneta_icon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_tool_button_active"
                    android:padding="6dp"
                    android:src="@drawable/ic_pencil"
                    android:contentDescription="Caneta" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Caneta"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tool_borracha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <ImageButton
                    android:id="@+id/tool_borracha_icon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@android:color/transparent"
                    android:padding="6dp"
                    android:src="@drawable/ic_eraser"
                    android:contentDescription="Borracha" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Borracha"
                    android:textColor="#9AA1AC"
                    android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tool_espessura"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/tool_espessura_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Espessura"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron_down"
                    android:contentDescription="@null" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="8dp"
                android:background="#332F9BFF" />

            <LinearLayout
                android:id="@+id/color_swatches"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical" />

            <ImageButton
                android:id="@+id/tool_limpar"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:background="@android:color/transparent"
                android:padding="5dp"
                android:src="@drawable/ic_eraser"
                android:contentDescription="Limpar" />
        </LinearLayout>

        <!-- "Mais" panel -->
        <LinearLayout
            android:id="@+id/mais_panel"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:background="@drawable/bg_overlay_panel"
            android:padding="6dp"
            android:elevation="8dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
